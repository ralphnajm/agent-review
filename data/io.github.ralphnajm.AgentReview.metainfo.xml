<component type="desktop-application">
  <id>io.github.ralphnajm.AgentReview</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Agent Review</name>
  <summary>Review the changes coding agents make</summary>
  <description>
    <p>
      Agent Review shows the uncommitted changes in your Git projects while a coding agent works on
      them. Mark files as reviewed, comment on specific lines, and hand the feedback back to the
      agent: post it for the agent to pull through MCP, or copy it to paste.
    </p>
    <ul>
      <li>Switch between projects at any time</li>
      <li>Browse all, staged or unstaged changes with syntax highlighting</li>
      <li>Updates live as files change</li>
      <li>Reviewed files are flagged when they change afterwards</li>
      <li>Post your review for your agent to pull, and see which comments it has resolved</li>
      <li>Or copy your feedback as Markdown, ready to paste into your agent</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.ralphnajm.AgentReview.desktop</launchable>
  <provides>
    <binary>agent-review</binary>
  </provides>
  <url type="homepage">https://github.com/ralphnajm/agent-review</url>
  <developer id="io.github.ralphnajm">
    <name>Ralph Najem</name>
  </developer>
